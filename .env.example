# ==============================================================================
# CLOUDEXAM ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Credentials (from Supabase Project Settings -> API)
# URL: https://[your-project-id].supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Safe for client/frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (CONFIDENTIAL - ONLY used on Backend/Vercel Functions)
# NEVER commit or expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Frontend Environment Variables (Angular build time)
# In Angular environment.ts:
# NG_APP_SUPABASE_URL=https://your-project.supabase.co
# NG_APP_SUPABASE_ANON_KEY=your-anon-key
# NG_APP_API_BASE_URL=/api/v1

